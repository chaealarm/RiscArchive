	// XXX XXX CRC down here to make bit stuffing timings line up.
	c.srli a2,1
    1cd4:	8205                	srli	a2,a2,0x1
	and a3,a3,t0
    1cd6:	0056f6b3          	and	a3,a3,t0
	c.xor  a2,a3 
