	c.srai a3,31    // Copy MSB into all other bits
    1cca:	86fd                	srai	a3,a3,0x1f

	// Flip s1 (our bshr setting) by xoring it.
	// 10.....01
	// 11.....11 (xor with)
	// 01.....10
	xor s1, s1, t1
    1ccc:	0064c4b3          	xor	s1,s1,t1
	sw s1, BSHR_OFFSET(a5)
    1cd0:	cb84                	sw	s1,16(a5)

	c.li a4, 6 // reset bit stuffing.
